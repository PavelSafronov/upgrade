{
  "name": "mongodb-upgrade-toolkit",
  "version": "0.1.7",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bump": "npm version --include-workspace-root -w packages/cli -w packages/mcp -w packages/eslint-plugin",
    "release": "npm publish --access public -w packages/cli -w packages/mcp -w packages/eslint-plugin"
  }
}
