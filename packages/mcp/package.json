{
  "name": "@pavel-safronov/upgrade-mcp",
  "version": "0.2.0",
  "description": "MCP server exposing MongoDB driver upgrade tools to AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PavelSafronov/upgrade.git"
  },
  "type": "module",
  "bin": {
    "upgrade-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pavel-safronov/upgrade": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
